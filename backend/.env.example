# ── Active provider ────────────────────────────────────────────────────────────
# "groq" (default) | "medgemma" | "gemini"
MODEL_PROVIDER=groq

# ── Groq (default / fallback) ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── MedGemma via llama.cpp (GGUF) ─────────────────────────────────────────────
# Model: docvm/medgemma-1.5-4b-it-GGUF  (Q4_K_M, ~2.5 GB)
#
# Local setup:
#   llama-server -m medgemma-1.5-4b-it-Q4_K_M.gguf --port 8080
#   MEDGEMMA_API_URL=http://localhost:8080
#
# For Vercel/Render demo (expose local server publicly):
#   ngrok http 8080
#   MEDGEMMA_API_URL=https://<your-ngrok-id>.ngrok-free.app
#
# MEDGEMMA_API_KEY is optional — only needed if you add auth to your server
MEDGEMMA_API_URL=
MEDGEMMA_API_KEY=
MEDGEMMA_MODEL_NAME=medgemma

# ── Gemini (optional stub) ────────────────────────────────────────────────────
GOOGLE_API_KEY=
